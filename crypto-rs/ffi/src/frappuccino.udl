// Frappuccino UniFFI interface definition.
//
// Scope:
//   S8a — crypto-rs/core: BIP-39, PinStore, Identity, Ratchet.
//   S8b — crypto-rs/stream: STRM encrypt/decrypt + V2 server client.
//
// Namespace `frappuccino` → Kotlin bindings under `uniffi.frappuccino.*`.
//
// Wire-format contract: all `bytes` arguments are ByteArray on the Kotlin
// side; this crate never returns a reference into internal Rust state — each
// call returns an owned copy that Kotlin is free to zero at its discretion.

namespace frappuccino {
    // Smoke-test API (S0) — keep stable so the existing RustSmokeTest stays green.
    string hello_world();
    string core_version();

    // -------- BIP-39 ----------------------------------------------------------

    /// Generate a fresh 12-word French mnemonic using OS entropy.
    ///
    /// Phase 6.1.4-B : retourne `bytes` (UTF-8) au lieu de `string`. Le
    /// mnemonic ne touche jamais le pool intern Java (immutable, non-
    /// wipeable). Le caller Kotlin reçoit un `ByteArray` qu'il peut wipe.
    bytes bip39_generate_fr();

    /// Normalize one word (trim, NFD, lowercase, canonical-prefix match).
    /// Throws FfiError::InvalidMnemonicWord if the word isn't in the FR list.
    ///
    /// Note Phase 6.1.4-B : reste sur `string` (UI helper autocomplete,
    /// risque secrecy limité — 1 mot ne révèle pas la phrase entière).
    [Throws=FfiError]
    string bip39_normalize_word_fr([ByRef] string input);

    /// Validate a full 12-word FR mnemonic (checksum + known words).
    /// Throws on any structural issue.
    ///
    /// Phase 6.1.4-B : `mnemonic` est `bytes` (UTF-8) au lieu de `string`.
    [Throws=FfiError]
    void bip39_validate_fr([ByRef] bytes mnemonic);

    // -------- PIN-protected store --------------------------------------------

    // `pin_store_seal` REMOVED from the FFI (2026-09-03). It had no Kotlin
    // caller at all: production seals in-crate via the `pin_session_*` calls
    // below, and the diff-fuzz harness only ever crosses the boundary for
    // `pin_store_open` (Main.kt). The Rust `pin_store_seal` SURVIVES in lib.rs
    // and must stay: the parity dumper calls it in pure Rust to build the blob
    // the harness then opens, and three unit tests cover the seal/open pair.

    /// Authenticate + decrypt a blob produced by the Rust-side `pin_store_seal`
    /// (no longer exported; see the note above). Returns
    /// WrongPin whether the PIN or the blob is the problem (indistinguishable
    /// on purpose — feed the lockout tracker).
    ///
    /// Phase 6.1.4-A : `pin` est `bytes` au lieu de `string`.
    [Throws=FfiError]
    bytes pin_store_open([ByRef] bytes pin, [ByRef] bytes blob);

    // Lot 4b P6 — `pin_store_open_extended` (+ `UnsealedBlob`),
    // `pin_store_seal_with_key` and `pin_store_open_with_key` REMOVED. They
    // ferried the Argon2id-derived key across the FFI and have no caller left
    // after the no-export migration: the combined `pin_session_*` calls below
    // open/seal/reseal entirely in-crate. Only `pin_store_open` above survives
    // on the FFI surface, and only for the diff-fuzz parity harness (0 prod
    // caller). The claim that `pin_store_seal` survived for the same reason was
    // wrong: the harness never crossed the boundary for it, which is why it was
    // removed in turn on 2026-09-03.

    // -------- PIN-session holder (Lot 4b — R-CR-1 no-export) -----------------
    // The Argon2id-derived key lives in a process-global Zeroizing holder
    // inside Rust (like the upload bearer). The combined calls below open/seal
    // IN-CRATE so the derived key, the ratchet 50-sk plaintext, the provenance
    // seed and the report master NEVER cross the FFI. The clear is wired to the
    // ratchet-wipe drain-safe events (lock / panic / auto-lock), NEVER a 401.

    /// Enrollment: run Argon2id once on `sealed_blob` and stash the derived key
    /// + salt in the holder (the ratchet is already in memory from the kit).
    [Throws=FfiError]
    void pin_session_populate([ByRef] bytes pin, [ByRef] bytes sealed_blob);

    /// Unlock: Argon2id once, stash the key in the holder, deserialize the
    /// ratchet — all in-crate. Returns the ratchet handle; neither the key nor
    /// the 50-sk plaintext crosses. Replaces pin_store_open_extended + deserialize.
    [Throws=FfiError]
    EphemeralRatchet pin_session_open_ratchet([ByRef] bytes pin, [ByRef] bytes sealed_blob);

    /// Unlock reload (OPTION B): unseal the provenance seed with the held key and
    /// reconstruct the signer in-crate. The seed never crosses the FFI.
    [Throws=FfiError]
    ProvenanceSigner pin_session_open_provenance_signer([ByRef] bytes sealed_blob);

    /// MIGRATION ONLY: unseal the legacy report master with the held key and
    /// rebuild the legacy keyring in-crate, for the legacy_convert_* and
    /// legacy_write_closure calls. The master never crosses the FFI. A device
    /// enrolled under the chained scheme has no master and never calls this.
    [Throws=FfiError]
    ReportKeyring pin_session_open_report_keyring([ByRef] bytes sealed_blob);

    // -------- Report state (Rust-owned file, process-wide lock) -------------
    // The state file (filesDir/report_state.bin) holds the index and chain
    // link of the NEXT report plus the directory seed, sealed with the
    // PIN-session key. Its plaintext never crosses the FFI. Every transition
    // runs under one process-wide lock. All of these need the PIN session.

    /// Enrollment: derive the state at index 0 from the phrase and write it,
    /// sealed, to `state_path` (replacing any file there: enrollment is a
    /// fresh start). The report master is never stored. Call after
    /// pin_session_populate. A failure must abort the enrollment.
    [Throws=FfiError]
    void pin_session_create_report_state([ByRef] bytes mnemonic, [ByRef] bytes passphrase, [ByRef] string state_path);

    /// Start a recording: open the next report and return its writer. The
    /// advanced state is durably written BEFORE the writer is returned; on any
    /// error there is no writer. The file is then unchanged, or, if only the
    /// final directory flush failed, holds the advanced state (the index is
    /// skipped; its key signed nothing). `author` is the
    /// identity every object is encrypted to. The report's directory entry is
    /// signed in this same call (written later by seal_directory_entry).
    /// Throws WriterBusy while another writer is live in the process.
    [Throws=FfiError]
    ReportWriter pin_session_open_report([ByRef] string state_path, StreamIdentity author);

    /// Migration: create the state at index `k` from the legacy master
    /// (unsealed in-crate from `master_sealed`, never crossing the FFI) and
    /// return the state's next index. Idempotent: an existing state is left
    /// untouched and its next index returned (recordings may have advanced
    /// it); one BEHIND `k` is refused (ReportRefused). k <= 1 000 000.
    [Throws=FfiError]
    u32 pin_session_migrate_report_state([ByRef] bytes master_sealed, u32 k, [ByRef] string state_path);

    /// Emergency wipe: abort the live writer, then securely delete the state
    /// file and any leftover `.part`. Idempotent.
    [Throws=FfiError]
    void report_state_wipe([ByRef] string state_path);

    /// Abort the live writer from anywhere in the process (emergency wipe,
    /// synchronous): its key is wiped, no closure is written. Waits for an
    /// opening in progress. Returns whether a writer was open.
    boolean report_writer_abort_live();

    /// Whether a writer is live (opened, neither closed nor aborted).
    boolean report_writer_is_live();

    // -------- Queue key -----------------------------------------------------
    // 32 random bytes per installation, persisted by Kotlin in its protected
    // storage (read back as a ByteArray, never a String) and installed at
    // process start; the caller's array is then wiped. Other copies the JVM
    // made on the way (stream buffers, the buffers carrying the bytes across
    // this boundary) are not. Without it no envelope can be written,
    // inspected or sent; the files stay.

    /// 32 fresh random bytes. NOT installed: persist them, then
    /// queue_key_install, then wipe the array.
    [Throws=FfiError]
    bytes queue_key_generate();

    /// Install the queue key for this process (replaces any installed key).
    [Throws=FfiError]
    void queue_key_install([ByRef] bytes key);

    /// Drop and wipe the installed queue key. Idempotent.
    void queue_key_clear();

    boolean queue_key_present();

    // -------- Queue envelopes -----------------------------------------------

    /// Decode an envelope's trailer without reading its payload (cheap enough
    /// for a whole queue). Throws EnvelopeCorrupt for a damaged envelope:
    /// move it to the failed directory, never retry it.
    [Throws=FfiError]
    EnvelopeInfo envelope_inspect([ByRef] string path);

    /// Send one envelope. Never throws. The envelope is verified in full
    /// (trailer, payload re-hash, report_id = H(pk), signatures) before
    /// anything goes on the network; the URL (PUT /file/{rid}/{name} or POST
    /// /close/{rid}), the headers and the body all come from it. Nothing is
    /// signed. `use_creation` adds X-Report-Create-Sig and the held bearer; it
    /// is ignored for a closure. Tags when http_status == 0, besides the
    /// transport's: no_queue_key, file_missing (no envelope at `path`, and only
    /// that), envelope_corrupt (permanent: failed directory), envelope_io,
    /// no_bearer, no_create_sig. With a response, error_detail is null except
    /// report_closed: a 409 whose body is the relay's {"detail":"Report
    /// closed"} (the closure does not cover this name); any other 409 has none.
    PutOutcome upload_send_envelope([ByRef] string base_url, [ByRef] string path, TransportMode mode, boolean use_creation);

    // -------- Migration of legacy files -------------------------------------
    // Each appends a trailer to the existing file and renames it (no copy),
    // signing NOW with the legacy key. Idempotent: an already converted source
    // is only renamed; a missing source whose destination is already an
    // envelope is reported as done. Resumable after a power cut during the
    // append: a marker `<dst_path>.conv` (not an envelope) records the payload
    // (length and hash) beside the destination until the envelope is in
    // place, and the next call cuts whatever the append left before
    // converting again.

    /// A pending legacy object of report `n`: kind Chunk (a `.strm`) or
    /// TimestampProof (a `.ots` already received). `filename` is its relay
    /// name, as the legacy upload used it. A chunk whose framing is not a
    /// whole STRM blob (cut short, bytes after the last chunk) throws
    /// InvalidBlob before anything is signed; a SINGLE blob cut short is not
    /// detectable without the archive key.
    [Throws=FfiError]
    EnvelopeInfo legacy_convert_report_object(ReportKeyring keyring, u32 n, EnvelopeKind kind, [ByRef] string filename, [ByRef] string src_path, [ByRef] string dst_path);

    /// The pending legacy directory entry of report `n` (relay name derived
    /// here from `n`).
    [Throws=FfiError]
    EnvelopeInfo legacy_convert_directory_entry(ReportKeyring keyring, u32 n, [ByRef] string src_path, [ByRef] string dst_path);

    /// The closure of legacy report `n` (empty manifest, seq_limit 0). Its
    /// info says needs_drain: send it only once no other envelope of the same
    /// report_id is queued.
    [Throws=FfiError]
    EnvelopeInfo legacy_write_closure(ReportKeyring keyring, u32 n, [ByRef] string out_path);

    // -------- Timestamp proof (opt-in) --------------------------------------

    /// Write the timestamp ticket of a closed report (CloseInfo.ots_name +
    /// the commitment from provenance_ots_commitment over
    /// CloseInfo.plaintext_hashes), sealed under the queue key. Workers get
    /// the ticket's path only.
    [Throws=FfiError]
    void ots_ticket_write([ByRef] string ticket_path, [ByRef] string ots_name, [ByRef] bytes commitment);

    /// The commitment a ticket asks to timestamp (public: sent to calendars).
    [Throws=FfiError]
    bytes ots_ticket_commitment([ByRef] string ticket_path);

    /// One call for a received proof: it must timestamp the ticket's
    /// commitment; it is STRM-encrypted to `author` in memory, signed with the
    /// directory key (needs the PIN session), and written as a timestamp-proof
    /// envelope at `out_path`. The proof never reaches the disk in clear.
    /// The ticket is deleted by this call once the envelope is written, so a
    /// run started again after a crash finds no ticket rather than sealing a
    /// second, different envelope under the same relay name.
    [Throws=FfiError]
    EnvelopeInfo pin_session_seal_ots_proof([ByRef] string state_path, [ByRef] string ticket_path, [ByRef] bytes proof, StreamIdentity author, [ByRef] string out_path);

    /// Rescue: compare a DECRYPTED proof file with the commitment recomputed
    /// from the verified objects. null = no proof. The Bitcoin anchoring is
    /// checked on a desktop with the CLI.
    [Throws=FfiError]
    OtsStatus ots_proof_status(string? decrypted_proof_path, [ByRef] bytes commitment);

    /// Zeroize + drop the cached PIN-session key. Idempotent. Wired to lock /
    /// panic-wipe / drain-safe auto-lock; NEVER to a 401 (not re-derivable
    /// without the PIN).
    void pin_session_clear();

    // -------- STRM (stream blob encrypt/decrypt) -----------------------------

    /// M-1 (WP-C) — true iff `name` is a single safe path component (no
    /// separator, not `.`/`..`, not absolute, not empty). The rescue device
    /// validates relay-supplied blob filenames with THIS shared guard before
    /// joining them onto a local output dir. The download FFIs also enforce it.
    boolean archive_blob_filename_is_safe([ByRef] string name);

    // Phase 8.1.6 (forensic finding #2, 2026-06-03) — the heap-returning
    // `strm_decrypt` is REMOVED from the FFI: it copied decrypted plaintext
    // into a non-Zeroizing JVM ByteArray that lingered on the heap.
    // Decrypted plaintext never crosses this boundary: `strm_decrypt_to_file`
    // below decrypts and writes the file inside Rust. (The Rust `strm_decrypt`
    // survives `#[cfg(test)]` only, for the in-memory roundtrip tests.)

    /// Decrypt the STRM blob at `input_path` to `output_path`. The rescue's
    /// decryption step, which comes AFTER verification: only a file a
    /// ReportCheck kept is decrypted. The plaintext never crosses the FFI;
    /// only the non-secret metadata does. A partial output is deleted on a
    /// write failure. Secure-delete `output_path` after use.
    [Throws=FfiError]
    BlobMetadata strm_decrypt_to_file([ByRef] string input_path, [ByRef] string output_path, ArchiveIdentity archive);

    /// Phase 6.1.4-D — secure-delete d'un fichier temporaire contenant
    /// des secrets (MP4 plaintext, blob STRM intermédiaire). Overwrite
    /// avec random + fsync + truncate + unlink. No-op si le fichier
    /// n'existe pas (idempotent).
    ///
    /// Throws FfiError::Io sur permission denied, disk full, etc.
    [Throws=FfiError]
    void secure_delete_file([ByRef] string path);

    // -------- Upload session bearer (§10.6, 2026-06-13) ----------------------
    // The upload JWT never crosses the FFI as a stored Kotlin String:
    // `StreamServerClient.verify` stashes it in a process-global Zeroizing
    // holder in Rust; the upload path pulls a transient copy per request via
    // `upload_auth_header()`; lock / panic / drain-complete call
    // `upload_auth_clear()` to zeroize it. Mirrors the old Kotlin
    // UploadAuthHolder, moved into Rust so the bearer is never a long-lived
    // JVM String (the §10.6 heap-dump finding).

    /// Transient "Bearer <jwt>" for one authenticated request, or null if no
    /// session is active. The JWT stays in the Rust holder; Kotlin only ever
    /// gets a short-lived per-call copy.
    string? upload_auth_header();

    /// Zeroize + drop the stored upload bearer AND reset the Rust upload client
    /// (evictAll-equivalent): every JWT clear also tears down upload connections
    /// carrying the bearer. lock / panic / 401 / auto-lock / drain-complete.
    void upload_auth_clear();

    /// Whether an upload session bearer is held (existence only — the bearer
    /// itself never crosses the FFI for the chunk path). Phase 1 heap-0 gate.
    boolean upload_auth_present();

    // `upload_put_chunk` REMOVED (2026-09-03), together with its Rust body and
    // the two transport entry points it was the sole caller of
    // (`stream::put_chunk` and `stream::put_chunk_quic`). It was the Phase 1
    // unauthenticated chunk PUT, superseded by the two capability-authorized
    // calls below when Phase C made every write carry a report signature.
    //
    // Removing the FFI function alone would have been cosmetic: both transport
    // entry points are `pub` and re-exported, so the compiler emits no dead-code
    // warning and the shipped .so would have kept carrying them.

    // `upload_put_report_chunk` and `upload_put_directory_entry` REMOVED. They
    // signed at SEND time from a keyring kept live for the session; every
    // object is now signed when produced and sent with upload_send_envelope.

    /// Re-arm the QUIC transport at the start of a recording. Releases the
    /// "QUIC cannot establish on this network" latch so a recovered network gets
    /// QUIC back at the next recording instead of waiting for a lock or an auth
    /// clear. Clears the latch alone, so a previous recording still draining
    /// chunks over the live connection is not disrupted. Idempotent, never
    /// throws; a .so built without the quic feature has no latch and this is a
    /// no-op. (Was a side effect of the retired upload_create_report, which
    /// stopped being called when report creation became lazy.)
    void upload_transport_rearm();

    // -------- Provenance (lean hash + Bitcoin, §10.11) -----------------------

    /// SHA-256 of a plaintext chunk file, computed in Rust (heap-0: read into a
    /// Zeroizing buffer, never crosses to the JVM). Returns the 32-byte hash,
    /// accumulated into `chunk_hashes` for `provenance_ots_commitment`.
    [Throws=FfiError]
    bytes provenance_hash_plaintext_file([ByRef] string path);

    /// §10.11 (lean "hash + Bitcoin") — the salted OTS commitment over the media
    /// Merkle root: SHA-256(salt ‖ chunk_merkle_root(chunk_hashes)), with
    /// salt = HKDF(provenance seed, recording_id). This is the ONLY provenance
    /// artifact now (no manifest, no signature, no sealing); the device submits
    /// this 32-byte commitment to the relay for trustless timestamping.
    [Throws=FfiError]
    bytes provenance_ots_commitment(
        sequence<bytes> chunk_hashes,
        [ByRef] bytes recording_id,
        ProvenanceSigner signer
    );
};

/// Transport selector for upload_send_envelope. DirectTls = pinned TLS over
/// TCP. ObfQuic = pinned HTTP/3 over obfuscated QUIC + BBR, with an automatic
/// fallback: a QUIC attempt that fails without an HTTP status is re-sent over
/// DirectTls in the same call, and a connection that cannot be established
/// latches QUIC off until upload_transport_rearm or an auth clear. A .so built
/// without the `quic` feature behaves as DirectTls.
enum TransportMode {
    "DirectTls",
    "ObfQuic",
};

/// Result of upload_send_envelope. http_status 0 = no HTTP response;
/// error_detail is then a short tag (see upload_send_envelope).
dictionary PutOutcome {
    u16 http_status;
    u64 upload_ms;
    u64 transfer_ms;
    string? error_detail;
    // Lot 3 B observability: which transport delivered this chunk -
    // "obfquic" / "directtls" / "directtls_fallback" / "directtls_degraded" / "none".
    string transport_used;
};

// ============================================================================
// Errors
// ============================================================================

// Note: variants use `detail` instead of `message` — UniFFI 0.28 generates an
// Exception subclass that would otherwise clash with the inherited `message`
// property of `kotlin.Throwable`.
[Error]
interface FfiError {
    InvalidMnemonicWord(string word, string language);
    InvalidMnemonic(string detail);
    DerivationFailed(string detail);
    EmptyInput();
    AlreadyConsumed(string resource);
    InvalidSignature();
    WrongPin();
    InvalidBlob(string detail);
    /// HTTP / TLS / framing failure from the V2 relay client.
    Network(string detail);
    Internal(string detail);
    /// Phase 6.1.4-D : I/O error during secure_delete_file
    /// (permission denied, file gone, disk full, etc.).
    Io(string detail);
    /// The report writer was closed or aborted: it seals nothing more.
    WriterClosed();
    /// A report writer is already live in this process.
    WriterBusy();
    /// No queue key installed: no envelope can be written or read (the files
    /// stay).
    NoQueueKey();
    /// The envelope is damaged or does not verify. Never send it, never
    /// re-sign it: move it to the failed directory.
    EnvelopeCorrupt(string detail);
    /// The report layer refused the call (seq order, duplicate seq, chunk
    /// before metadata, migration point behind the state...). Retrying the
    /// same call fails the same way.
    ReportRefused(string detail);
    /// The relay answered 429: wait at least `retry_after_secs`, then retry
    /// the same request.
    RateLimited(u64 retry_after_secs);
};

// ============================================================================
// Value types (dictionaries — records without behaviour)
// ============================================================================

/// Kotlin-friendly projection of `core::ratchet::RatchetSignature`.
dictionary RatchetSignature {
    bytes signature;                 // 64 bytes
    bytes ephemeral_public_key;      // 32 bytes
    u32 batch_number;
    u32 key_index;
};

/// Kotlin-friendly projection of `core::ratchet::RotationProof`. The 50 new
/// public keys are serialized as `sequence<bytes>` (50 × 32-byte entries).
dictionary RotationProof {
    u32 new_batch_number;
    sequence<bytes> new_batch_public_keys;
    bytes signer_public_key;
    u32 signer_batch_number;
    u32 signer_key_index;
    bytes signature;
};

/// One object of an ArchiveListing (relay-supplied, unverified).
dictionary ArchiveBlobInfo {
    string filename;
    u64 size;
    string? last_modified;
};

/// A closure as the relay recorded it (unverified).
dictionary ArchiveClosureInfo {
    u32 seq_limit;
    bytes manifest_sha256;   // 32 bytes
    bytes sig;               // 64 bytes
};

/// Result of StreamServerClient.archive_list (relay-supplied, unverified).
dictionary ArchiveListing {
    sequence<ArchiveBlobInfo> blobs;
    ArchiveClosureInfo? closure;
};

enum ArchiveFetchStatus {
    "Stored",
    "NotFound",
};

/// The write-signature header of a fetched object.
enum WriteSigState {
    "Absent",
    "Present",
    "Malformed",
};

/// Result of StreamServerClient.archive_fetch_object. The object is on disk,
/// still encrypted; this only says what was fetched, not whether to keep it.
dictionary ArchiveObjectResult {
    ArchiveFetchStatus status;
    u64 size;
    bytes? blob_sha256;      // 32 bytes, null when not found
    WriteSigState write_sig_state;
    bytes? write_sig;        // 64 bytes when Present
};

// ---- Report pipeline -------------------------------------------------------

/// What a queue envelope carries.
enum EnvelopeKind {
    "Chunk",
    "DirectoryEntry",
    "Closure",
    "TimestampProof",
};

/// What Kotlin needs to schedule an envelope, from its trailer. No signature
/// and no key.
dictionary EnvelopeInfo {
    EnvelopeKind kind;
    string report_id_hex;    // groups a report's envelopes
    string filename;         // relay object name, empty for a closure
    boolean needs_drain;     // legacy closure: send only once nothing else of the report is queued
    boolean has_create_sig;  // can be sent in creation mode
    u32 seq_limit;           // closure only, else 0
    u64 payload_len;
};

/// Result of ReportWriter.seal_chunk_file.
dictionary SealedChunk {
    u32 seq;
    u64 blob_bytes;          // size of the encrypted object
};

/// Result of a successful ReportWriter.close_report.
dictionary CloseInfo {
    u32 index;
    string report_id_hex;
    u32 seq_limit;
    u32 object_count;                  // metadata included
    sequence<bytes> plaintext_hashes;  // seq >= 1, increasing seq: OTS commitment leaves
    string ots_name;                   // for ots_ticket_write
};

enum OtsStatus {
    "Match",
    "Mismatch",
    "Absent",
};

// ---- Rescue ----------------------------------------------------------------

enum ReportScheme {
    "Legacy",
    "Chain",
    "Directory",
};

/// A report to probe. Keys and ids are always re-derived by Rust from these;
/// `index` is ignored for the directory.
dictionary RescueTarget {
    ReportScheme scheme;
    u32 index;
};

/// The verdict on one fetched object.
enum ObjectStatus {
    "Verified",          // kept: part of the verified testimony
    "Foreign",           // listed by the valid closure, other bytes: excluded
    "Missing",           // listed (by the closure or the relay) but not stored
    "Unexpected",        // outside the valid closure, unsigned: excluded
    "UnexpectedSigned",  // outside the valid closure, validly signed: excluded, report ALTERED
    "Unverifiable",      // legacy/directory object without a stored signature: kept APART
    "Invalid",           // no valid signature where one is required: excluded
};

enum ClosureState {
    "Absent",
    "Unchecked",
    "Valid",
    "Invalid",
};

enum ReportStatus {
    "Complete",      // chained, validly closed, everything verified
    "Incomplete",    // chained, validly closed, only missing (or unfetched) objects
    "Altered",       // chained, validly closed, a foreign object or a second signer
    "Interrupted",   // chained, no valid closure: objects verified one by one
    "Legacy",
    "Directory",
};

/// Everything shown for one report.
dictionary ReportVerdict {
    ReportScheme scheme;
    u32? index;
    ReportStatus status;
    ClosureState closure;            // Valid on a legacy report = frozen on the relay
    boolean closure_anomaly;         // an invalid closure, or any closure of the directory
    u32 verified;
    u32 foreign;
    u32 missing;
    u32 unexpected;
    u32 unexpected_signed;
    u32 unverifiable;
    u32 invalid;
    u32 unchecked;                   // listed objects not fetched yet
    sequence<string> verified_names; // reading order (increasing seq)
    sequence<string> unverifiable_names;
    sequence<u32> missing_seqs;
    string? first_modified;          // date range of the listing (relay clock)
    string? last_modified;
};

/// Non-secret metadata accompanying a decrypted STRM blob. F-C1: no author
/// identity field — the witness identity is never written at rest (V3) nor
/// surfaced across the FFI.
dictionary BlobMetadata {
    u8 version;
    u8 mode;                     // 1 = SINGLE, 2 = CHUNKED
    u16 grant_count;
    u64 plaintext_len;
};

// Phase 8.1.6 (forensic finding #2) — the `StrmPlaintext` dictionary is
// removed with the heap-returning `strm_decrypt`. Decrypt metadata is
// returned by `strm_decrypt_to_file` as `BlobMetadata`; no plaintext
// ByteArray crosses the FFI anymore.

/// Fresh challenge payload returned by `StreamServerClient.challenge`. The
/// client MUST pass `nonce ‖ timestamp_BE_u64` (40 bytes) to the ratchet, which
/// prepends the 0x01 domain tag and signs 41 — signing the raw nonce, or the 40
/// bytes without the tag, is rejected by the server.
dictionary ChallengeValue {
    bytes nonce;         // 32 bytes
    u64 timestamp;       // Unix seconds (server clock)
};

/// Outcome of an enrollment attempt. Maps to a Kotlin sealed class.
[Enum]
interface EnrollResult {
    Success();
    AlreadyEnrolled();
    Failed(u16 code, string body);
};

// ============================================================================
// Interfaces (types with methods, held by Kotlin as handles)
// ============================================================================

/// Public-only identity pair (Ed25519 + X25519 pubs). Cheap to clone, no
/// secret material inside — safe to expose across FFI and log.
interface StreamIdentity {
    /// Rebuild a StreamIdentity from previously-published public keys. Used
    /// when the keys were persisted on device after onboarding and we want
    /// to pass a StreamIdentity to server-facing APIs (verify) without
    /// re-deriving from the BIP-39 phrase.
    [Throws=FfiError, Name=from_public_keys]
    constructor([ByRef] bytes ed25519_pk, [ByRef] bytes x25519_pk);

    bytes ed25519_pk();
    bytes x25519_pk();
    string ed25519_pk_hex();

    /// 6 groups of 4 hex chars — used in the UI to let the user verify their
    /// phrase landed on the right identity.
    string readable_fingerprint();

    // `verify` REMOVED from this interface (2026-09-03). It has been on the
    // surface since the UniFFI layer was created and never acquired a caller.
    // Do not confuse it with `StreamServerClient.verify` further down, which is
    // the live V2 authentication call. The Rust fn SURVIVES in lib.rs: its unit
    // test is the oracle proving `EnrollmentKit::sign_enrollment` signs under
    // the 0x03 domain prefix.
};

/// One-shot holder of the long-term Ed25519 secret + `chain_0`. After
/// `EphemeralRatchet.from_kit` the chain is gone; after `wipe()` the ed25519
/// secret is wiped too. Kotlin callers should construct one, call
/// sign_enrollment + EphemeralRatchet.from_kit, then let it drop (or call
/// wipe() defensively).
/// Note: method named `wipe()` (not `close()`) to avoid clashing with
/// Kotlin's `AutoCloseable.close()` inherited signature.
interface EnrollmentKit {
    /// Phase 6.1.4-B : `mnemonic` et `passphrase` sont `bytes` (UTF-8) au
    /// lieu de `string`. Le mnemonic ne touche jamais le pool intern Java.
    [Throws=FfiError, Name=from_mnemonic]
    constructor([ByRef] bytes mnemonic, [ByRef] bytes passphrase);

    [Throws=FfiError]
    StreamIdentity identity();

    /// R-C-1 domain separation: the long-term enrollment signing context, so
    /// the domain tag is never the caller's free choice across the FFI. (Phase
    /// C relay-blind retired `sign_archive_challenge` / the 0x04 ArchiveAuth
    /// domain — archive reads are now identity-free.)
    [Throws=FfiError]
    bytes sign_enrollment([ByRef] bytes message);

    void wipe();
};

/// Re-derivable archive identity — exposes X25519 unseal only, never returns
/// the secret scalar across FFI.
interface ArchiveIdentity {
    /// Phase 6.1.4-B : `mnemonic` et `passphrase` sont `bytes` (UTF-8) au
    /// lieu de `string`.
    [Throws=FfiError, Name=from_mnemonic]
    constructor([ByRef] bytes mnemonic, [ByRef] bytes passphrase);

    StreamIdentity identity();

    // B-CR-4 (audit 2026-06-26) — the heap-returning `decrypt_session_key` is
    // REMOVED from the FFI surface. It returned the 32-byte STRM session key
    // into a non-Zeroizing JVM ByteArray (the R-CR-1 class), and it had ZERO
    // production callers: the rescue decrypts inside Rust via
    // `strm_decrypt_to_file`, so the session key never crosses the boundary.
    // The Rust unseal lives on at `core::identity::ArchiveIdentity::
    // decrypt_session_key`, used by the in-Rust `stream::decrypt` path.
};

/// The witness's dedicated provenance secret (§10.11). A separate Ed25519 key
/// derived from the BIP-39 seed under its own HKDF context — never the device,
/// never the long-term identity key. **It signs nothing**: the signed-manifest
/// design it was named for was removed in the 2026-06-25 metadata walk-back, and
/// all that survives is deriving the per-recording OTS blinding salt. Derived
/// once at enrollment (`from_mnemonic`); the caller PIN-seals it in-crate via
/// `seal_with_session` and reloads it at unlock
/// (`pin_session_open_provenance_signer`) so it is live during recording — the
/// seed never crosses the FFI.
interface ProvenanceSigner {
    /// Enrollment-time: derive from the mnemonic (UTF-8 bytes, like
    /// EnrollmentKit.from_mnemonic — never touches the Java intern pool).
    [Throws=FfiError, Name=from_mnemonic]
    constructor([ByRef] bytes mnemonic, [ByRef] bytes passphrase);

    // `from_seed` REMOVED from the surface (2026-09-03): no Kotlin caller. The
    // Rust fn SURVIVES and is load-bearing — `pin_session_open_provenance_signer`
    // calls it on the unlock path, so production depends on it transitively.

    /// Lot 4b (OPTION B) — seal the seed with the held PIN-session key in-crate;
    /// returns the sealed blob. The seed never crosses the FFI.
    [Throws=FfiError]
    bytes seal_with_session();

    /// §10.11 Phase B — derive the per-recording OTS commitment salt for
    /// `recording_id` (16 bytes). Re-derived at rescue to export into the
    /// disclosure bundle so a verifier can recompute the salted commitment;
    /// never sent to the relay.
    [Throws=FfiError]
    bytes ots_salt([ByRef] bytes recording_id);
};

/// The LEGACY per-index report keyring, for the migration only. Obtained from
/// pin_session_open_report_keyring and passed to legacy_convert_* /
/// legacy_write_closure, which sign the legacy objects still pending and close
/// the legacy reports. Deliberately opaque: no constructor and no method, so a
/// migrated device cannot keep producing legacy addresses or signatures.
/// (Its constructor from the phrase, seal_with_session, report_id_hex,
/// directory_id_hex and directory_entry_name_hex are REMOVED: enrollment now
/// creates the report state, and the rescue uses ReportRescue.)
interface ReportKeyring {
};

/// The writer of one open report (from pin_session_open_report). Every object
/// is encrypted, signed and written as a queue envelope in ONE call, and
/// recorded only once that envelope is durably on disk. Run every call from
/// one FIFO executor. After close_report or abort, every call throws
/// WriterClosed.
interface ReportWriter {
    u32 index();
    string report_id_hex();

    /// Neither closed nor aborted.
    boolean is_open();

    /// Write the report's directory entry envelope (signed by the directory
    /// key at opening). First thing to write. Rewriting replaces the file.
    [Throws=FfiError]
    void seal_directory_entry([ByRef] string out_path);

    /// Seal the metadata JSON as seq 0. Mandatory before any chunk.
    [Throws=FfiError]
    void seal_metadata([ByRef] bytes json, [ByRef] string out_path);

    /// Seal media chunk `seq` (capture number >= 1, gaps allowed) from the MP4
    /// at `input_path`. Transactional: on error the table is unchanged,
    /// nothing is left at `out_path`, the MP4 is untouched; delete the MP4 only
    /// after success. A seq already sealed is refused (ReportRefused).
    [Throws=FfiError]
    SealedChunk seal_chunk_file(u32 seq, [ByRef] string input_path, [ByRef] string out_path);

    /// Sign the closure over every sealed object, write its envelope durably,
    /// then wipe the key. A failed write is retried by calling again (same
    /// manifest and signature); from the first call on, no object is accepted.
    /// Refused (ReportRefused, writer left open) if the metadata was never
    /// sealed. Not named `close`: the generated class already has an
    /// AutoCloseable close() that frees the handle.
    [Throws=FfiError]
    CloseInfo close_report([ByRef] string out_path);

    /// Wipe the key without a closure. Idempotent.
    void abort();
};

/// Rescue: everything derived from the phrase (both schemes, the directory).
/// Usage: open_directory -> planner -> loop { next, open_report, record } ->
/// for each ReportCheck found: verify_closure (if has_closure), fetch_object
/// for each object_names, verdict. A RateLimited error means: wait, then
/// repeat the same call.
interface ReportRescue {
    /// Validates the phrase (words AND checksum) first.
    [Throws=FfiError, Name=from_mnemonic]
    constructor([ByRef] bytes mnemonic, [ByRef] bytes passphrase);

    /// List the directory; null if the relay has none.
    [Throws=FfiError]
    ReportCheck? open_directory(StreamServerClient client);

    /// The enumeration plan from the directory's check (null = absent).
    [Throws=FfiError]
    RescuePlanner planner(ReportCheck? directory);

    /// List the report `target` re-derives; null on 404 (record found = false).
    [Throws=FfiError]
    ReportCheck? open_report(StreamServerClient client, RescueTarget target);
};

/// The enumeration, one target at a time.
interface RescuePlanner {
    /// The next target to probe, null when the enumeration is over.
    RescueTarget? next();

    /// Outcome of probing the target next() returned last. Not on a 429.
    void record(boolean found);

    /// Directory names that matched no index (an anomaly to show).
    u32 unmatched_entries();

    /// Whether the long tail is probed (directory absent or closed).
    boolean probes_long_tail();

    /// Once next() returned null: whether the enumeration stopped on the probe
    /// cap with the tail not exhausted. Reports past the cap were not looked
    /// for; show the enumeration as incomplete.
    boolean hit_probe_cap();
};

/// The verification of one listed report. Nothing it does not verify stays on
/// disk.
interface ReportCheck {
    ReportScheme scheme();
    u32? index();

    /// Re-derived, never read from the relay. Not a name for local files.
    string report_id_hex();

    /// Name of a chained report's timestamp proof in the directory.
    string? ots_name();

    /// Listed objects to fetch, increasing name order (= increasing seq).
    sequence<string> object_names();

    boolean has_closure();

    /// Fetch the manifest to `scratch_path`, check the closure, delete the
    /// file. Must precede fetch_object on a chained report with a closure.
    /// The first Valid or Invalid decision is final; a later call returns it.
    [Throws=FfiError]
    ClosureState verify_closure([ByRef] string scratch_path);

    /// Fetch one listed object (encrypted) to `out_path` and classify it; the
    /// file is deleted unless the status is Verified or Unverifiable.
    [Throws=FfiError]
    ObjectStatus fetch_object([ByRef] string name, [ByRef] string out_path);

    [Throws=FfiError]
    ReportVerdict verdict();
};

/// Stateful batched Ed25519 ratchet. All methods take &self with internal
/// locking on the Rust side, so Kotlin can call freely from a single thread.
interface EphemeralRatchet {
    /// Consumes `kit.chain_0` (post-call the kit's chain slot is empty).
    [Throws=FfiError, Name=from_kit]
    constructor(EnrollmentKit kit);

    // `deserialize` and `serialize` below have NO production caller, and that is
    // deliberate: production seals the ratchet in-crate through `seal_with_pin` /
    // `reseal_session_blob`, which never hand the blob to the JVM. They stay on
    // the surface for the diff-fuzz parity harness, which replays a V2 blob
    // through the real bindings and compares Kotlin against Rust
    // (`difffuzz-jvm/src/main/kotlin/Main.kt`, case ratchet_deserialize_serialize).
    // Remove either one and that harness stops compiling, which is exactly how a
    // future "dead surface" pass would break it in silence. They go together: the
    // harness tests the round-trip.

    /// Resume from a previously-serialized **V2** blob. V1 blobs are REJECTED
    /// (`CryptoError::InvalidBlob`, RT-03 fix) — they predate the MAC, so
    /// accepting them would accept an unauthenticated ratchet. An earlier
    /// version of this line said "V1 legacy + V2 supported", which the code has
    /// contradicted since RT-03.
    [Throws=FfiError, Name=deserialize]
    constructor([ByRef] bytes blob);

    /// Serialize to a V2 blob (4876 bytes). Throws on un-initialized state.
    [Throws=FfiError]
    bytes serialize();

    /// Lot 4b — serialize + seal with the held PIN-session key in-crate; returns
    /// the sealed blob to persist. Neither the 50-sk plaintext nor the key
    /// crosses the FFI. The fast-reseal hot path.
    [Throws=FfiError]
    bytes reseal_session_blob();

    /// Lot 4b — serialize + PIN-seal (Argon2id) in-crate for the INITIAL
    /// enrollment persistence (before a PIN session exists). 50-sk never crosses.
    [Throws=FfiError]
    bytes seal_with_pin([ByRef] bytes pin);

    /// The active batch number (0 once wiped). Lets Kotlin read the counter
    /// without serializing the 50-sk blob to parse the header.
    [Throws=FfiError]
    u32 batch_number();

    /// 50 × 32-byte public keys of the active batch.
    [Throws=FfiError]
    sequence<bytes> batch_public_keys();

    /// Number of unconsumed slots left in the current batch (0..=50).
    /// Used by the Kotlin auto-rotate trigger (`maybeAutoRotate`) — without
    /// this, the trigger was a stub returning 50 constant, leaving rotation
    /// permanently disabled (RT-07).
    [Throws=FfiError]
    u32 remaining_in_batch();

    /// Sign `message` with the next available slot, mark it consumed.
    [Throws=FfiError]
    RatchetSignature sign_and_advance([ByRef] bytes message);

    /// Roll forward to the next batch, consuming one slot of the current
    /// batch to sign the 50 fresh public keys.
    [Throws=FfiError]
    RotationProof advance_batch();

    /// Proactive wipe — all 50 private keys + chain key zeroed. Safe to call
    /// multiple times.
    void wipe();
};

/// Blocking HTTP client for the Frappuccino V2 relay.
/// All methods are thread-safe (internally cheap-cloning `Arc`).
interface StreamServerClient {
    /// Build a client against `base_url` (typically `"https://relay.example.org:8443"`).
    /// TLS config embeds the pinned self-signed cert + SPKI SHA-256 gate.
    [Throws=FfiError, Name=new]
    constructor([ByRef] string base_url);

    /// POST /auth/v2/enroll — register a fresh identity with its first batch.
    [Throws=FfiError]
    EnrollResult enroll(
        [ByRef] string identity_pk_hex,
        [ByRef] sequence<bytes> batch0_public_keys,
        [ByRef] bytes batch0_signature
    );

    /// POST /auth/challenge — 32-byte server nonce bound to a server timestamp.
    /// The caller must sign `nonce ‖ timestamp_BE_u64` via the ratchet.
    [Throws=FfiError]
    ChallengeValue challenge();

    /// POST /auth/v2/verify — swap a ratchet signature for a JWT. `sig` must
    /// cover `nonce ‖ timestamp_BE_u64` and `timestamp` must be the one
    /// returned by `challenge()`.
    ///
    /// §10.6 (2026-06-13) — returns `true` on success and stashes the bearer
    /// in the process-global Rust holder (see `upload_auth_header`); the JWT
    /// is NOT returned to Kotlin. Returns `false` when the server refused
    /// (stale slot, wrong batch, clock skew > 30 s, etc.).
    [Throws=FfiError]
    boolean verify(
        StreamIdentity identity,
        RatchetSignature sig,
        [ByRef] string nonce_hex,
        u64 timestamp
    );

    /// POST /auth/v2/rotate-batch — advance to batch N+1. Returns false iff
    /// the server refused.
    [Throws=FfiError]
    boolean rotate_batch([ByRef] string identity_pk_hex, RotationProof proof);

    /// GET /api/v2/archive/reports/{report_id}/blobs, identity-free: the
    /// report's objects and recorded closure (unverified). null on 404 (a hole
    /// in the enumeration). Throws RateLimited on 429, Network on any other
    /// failure (never mistaken for a hole).
    [Throws=FfiError]
    ArchiveListing? archive_list([ByRef] string report_id);

    /// GET one stored object, as stored (encrypted), to `output_path`, never
    /// into the JVM. Durable write, hashed while written; nothing left on
    /// error. Fetch only: whether to keep it is a ReportCheck's decision.
    [Throws=FfiError]
    ArchiveObjectResult archive_fetch_object(
        [ByRef] string report_id,
        [ByRef] string filename,
        [ByRef] string output_path
    );

    // `archive_list_blobs`, `archive_download_and_decrypt` and
    // `archive_download_raw` REMOVED: they downloaded (and decrypted) without
    // verifying. The rescue now verifies before keeping (ReportCheck), then
    // decrypts what it kept with strm_decrypt_to_file.
};
