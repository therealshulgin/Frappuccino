<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="DialogBottomPopUpText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:fontFamily">@font/open_sans</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingLeft">15dp</item>
        <item name="android:paddingRight">15dp</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="AppBottomSheetDialogTheme" parent="Theme.MaterialComponents.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/drag_anchor_drawable</item>
        <item name="android:windowSoftInputMode">adjustResize|stateVisible</item>
        <item name="android:windowIsFloating">false</item>
    </style>




    <style name="RadioListButtonStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/wa_white</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">20dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">2dp</item>
    </style>

    <style name="Tella_Main_White_Text">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/open_sans</item>
        <item name="android:textColor">@color/wa_white</item>
        <item name="android:textSize">40sp</item>
    </style>

    <style name="Tella_Main_White_Text.Bold">
        <item name="android:textStyle">bold</item>
        <item name="lineHeight">19dp</item>
        <item name="android:textFontWeight">700</item>
    </style>

    <style name="Tella_Main_White_Text.Meduim">
        <item name="android:textSize">14sp</item>
    </style>


    <style name="Tella_Main_White_Text.MeduimbBold" parent="Tella_Main_White_Text.Bold">
        <item name="android:textSize">14sp</item>
    </style>





    <style name="Style_EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">24dp</item>
        <item name="android:layout_marginEnd">24dp</item>
        <item name="android:layout_marginTop">40dp</item>
        <item name="android:background">@drawable/bg_edittext</item>
        <item name="android:letterSpacing">0.2</item>
        <item name="android:cursorVisible">true</item>
        <item name="android:clickable">true</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/wa_white</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Tella2_BottomSheet_Text">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:lineHeight">21dp</item>
        <item name="android:textColor">@color/wa_white</item>
        <item name="android:fontFamily">@font/open_sans</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>
    <style name="DialogBottomPopUpBackground">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:layout_gravity">bottom</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:layout_marginBottom">54dp</item>
        <item name="android:background">@drawable/pop_up_background</item>
    </style>

    <style name="Tella_Progress_Circular">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:indeterminate">true</item>
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:visibility">gone</item>
        <item name="trackColor">@color/wa_white</item>
        <item name="indicatorColor">@color/tigers_eye</item>
        <item name="trackThickness">4dp</item>
    </style>


    <style name="Unlock_White_Text">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/wa_white</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAlignment">center</item>
        <item name="android:fontFamily">@font/open_sans</item>
        <item name="android:textStyle">normal</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Unlock_White_Text_Back" parent="Unlock_White_Text">
        <item name="android:layout_marginBottom">18dp</item>
        <item name="android:layout_marginStart">34dp</item>
    </style>

    <style name="Unlock_White_Text_Pin" parent="Unlock_White_Text_Back">
        <item name="android:layout_width">54dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textSize">30sp</item>
        <item name="android:layout_marginBottom">0dp</item>
        <item name="android:clickable">true</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>











    <!-- Phase 6.1.16: relocated from tella-locking-ui (module removed). The V2
         PIN screens (mobile) reference these; their siblings Unlock_White_Text,
         Unlock_White_Text_Back and Style_EditText already live in this module. -->
    <style name="Unlock_White_Text_Bold" parent="Unlock_White_Text">
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">20dp</item>
    </style>

    <style name="Unlock_White_Text_Medium" parent="Unlock_White_Text">
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Password_EditText" parent="Style_EditText">
        <item name="android:inputType">numberPassword</item>
    </style>

</resources>