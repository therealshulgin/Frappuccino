# Frappuccino relay — environnement.
# Copier vers .env et remplir, NE JAMAIS committer le .env rempli.
#
# Génération secrets :
#   JWT_SECRET=$(openssl rand -base64 48)
#   MINIO_ROOT_USER=$(openssl rand -hex 8)
#   MINIO_ROOT_PASSWORD=$(openssl rand -base64 32)

# === MinIO (object storage chunks chiffrés) ===
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Phase 6.1.2 — MINIO_SECURE active le TLS sur la connexion serveur->MinIO.
# Défaut `false` : server<->MinIO passe par le bridge docker interne en HTTP
# (suffisant en mode solo single-host). Passe à `true` UNIQUEMENT après avoir
# provisionné des certs TLS côté MinIO (sinon le handshake serveur échoue).
# Fait partie du durcissement "mode domaine" — flippe-le avec DOMAIN ci-dessous.
# Le serveur lit cette var via app/config.py ; le docker-compose la propage.
MINIO_SECURE=false

# === FastAPI auth ===
JWT_SECRET=

# Phase 6.1.3 — uvicorn workers. Le nonce cache (auth challenge replay
# protection) est process-local (dict + lock + persisté .nonce_cache.json).
# Plusieurs workers = chacun son cache = un nonce mis par worker A peut
# être inconnu de worker B → bypass via load-balancing.
# OBLIGATOIRE : tant qu'on n'a pas migré le cache vers Redis (Phase 6.1.3
# follow-up), démarrer uvicorn avec `--workers 1`. Voir systemd unit
# `frappuccino-relay.service` qui doit appliquer cette contrainte.
UVICORN_WORKERS=1

# === FLAG MAÎTRE : domaine vs IP solo (Phase 6.1.2) ===
# DOMAIN est l'interrupteur unique du durcissement "mode domaine" :
#   vide   → mode SOLO (tu testes seul) : HOST nginx = RELAY_HOST (l'IP), cert
#            auto-signé (tls/gen-self-signed.sh), PAS de HSTS, MINIO_SECURE=false.
#   rempli → mode DOMAINE (plus seul) : Let's Encrypt + HSTS, et tu passes
#            MINIO_SECURE=true (une fois MinIO en TLS).
# Génère la conf nginx correspondante avec deploy/nginx/render-relay-conf.sh
# (il lit DOMAIN/RELAY_HOST/RELAY_PORT ici). Runbook du flip : deploy/README.md.
DOMAIN=
TLS_EMAIL=
# IP du relais — sert de HOST nginx quand DOMAIN est vide (mode solo).
RELAY_HOST=136.244.101.236

# === Port relais ===
# Conserver 8443 tant que le client Android est pinné dessus
# (PIN_SHA256_B64 + PINNED_HOST dans crypto-rs/stream/src/pin.rs).
# Migration vers 443 = bump SPKI pin client + rebuild APK.
RELAY_PORT=8443

# === Durée de vie du JWT d'accès (Phase 6.1.1) ===
# Heures avant expiration de l'access-token. Défaut 24. PAS de refresh token
# (by design : en V2 le re-auth consomme un slot éphémère = refresh
# forward-secure ; un refresh token long-vécu réintroduirait le bearer
# persistant que le ratchet éphémère élimine). Un token volé est borné par
# cette valeur ET révocable immédiatement via POST /auth/v2/logout.
JWT_EXPIRE_HOURS=24
