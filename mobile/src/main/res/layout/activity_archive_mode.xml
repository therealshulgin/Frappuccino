<?xml version="1.0" encoding="utf-8"?>
<!--
  Le root doit rester un NestedScrollView, surtout pas un ScrollView — c'est
  pourtant la simplification réflexe, et la seule que le nom de l'écran
  suggère. La liste de rapports est une RecyclerView en wrap_content, et sous
  un ScrollView classique LinearLayoutManager ne mesure les items qu'à la
  demande : la liste rend alors 1 item au lieu de N.

  Le pendant de ce choix est `android:nestedScrollingEnabled="false"` posé sur
  chacune des deux RecyclerView plus bas (rapports, section « non
  vérifiable »), qui fait du NestedScrollView l'unique scroller de l'écran.
  Retirer l'un sans l'autre redonne deux scrollers qui se disputent le geste.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_purple">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Titre -->
        <TextView
            style="@style/OsintTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_gravity="center_horizontal"
            android:text="@string/archive_title" />

        <!-- Description -->
        <TextView
            style="@style/OsintSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:text="@string/archive_prompt" />

        <!-- Avertissement : ce qui reste sur le téléphone et quand c'est effacé. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/wa_orange"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:background="#22CC1A1A"
            android:text="@string/archive_warning" />

        <!-- Saisie de la phrase. `saveEnabled="false"` : sans lui, l'EditText
             range son texte dans l'état sauvegardé de l'activité, un Bundle
             confié au système, et la phrase quitterait l'écran. Pour la même
             raison, pas d'autofill. -->
        <EditText
            android:id="@+id/archiveMnemonicInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minLines="3"
            android:maxLines="4"
            android:inputType="textMultiLine|textNoSuggestions|textVisiblePassword"
            android:imeOptions="actionDone"
            android:saveEnabled="false"
            android:importantForAutofill="no"
            android:textColor="@color/wa_white"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:background="@color/wa_darker_gray"
            android:padding="12dp"
            android:hint="@string/archive_input_hint"
            android:textColorHint="#55FFFFFF"
            android:gravity="top|start" />

        <TextView
            android:id="@+id/archiveUnlockBtn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/archive_unlock"
            android:textColor="@color/wa_white"
            android:textSize="14sp"
            android:fontFamily="@font/impact"
            android:letterSpacing="0.15"
            android:background="@color/wa_orange"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/archiveStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:textColor="@color/wa_white"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/archiveFingerprint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:textColor="@color/wa_white"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:visibility="gone" />

        <TextView
            android:id="@+id/archiveStreamsInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:padding="12dp"
            android:background="@color/wa_darker_gray"
            android:textColor="@color/wa_white"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:visibility="gone" />

        <!-- Lance la recherche des rapports ; après une recherche incomplète
             ou arrêtée, le même bouton la relance. -->
        <TextView
            android:id="@+id/archiveRetrieveBtn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/archive_retrieve_btn"
            android:textColor="@color/wa_white"
            android:textSize="14sp"
            android:fontFamily="@font/impact"
            android:letterSpacing="0.15"
            android:background="@color/wa_orange"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <!-- État de la recherche : progression, attente sur 429, fin
             complète ou INCOMPLÈTE. Une recherche incomplète doit se lire
             comme telle, jamais comme une liste courte. -->
        <TextView
            android:id="@+id/archiveEnumStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/wa_white"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:visibility="gone" />

        <!-- Anomalies de l'annuaire (clos, absent, entrées inconnues). -->
        <TextView
            android:id="@+id/archiveAnomalies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="8dp"
            android:background="#22CC1A1A"
            android:textColor="@color/wa_orange"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:visibility="gone" />

        <!-- Vérifie, l'un après l'autre, les rapports pas encore vérifiés. -->
        <TextView
            android:id="@+id/archiveVerifyAllBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/archive_verify_all_btn"
            android:textColor="@color/wa_white"
            android:textSize="13sp"
            android:fontFamily="@font/impact"
            android:letterSpacing="0.15"
            android:background="@color/wa_orange"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <!-- Liste des rapports. `nestedScrollingEnabled="false"` n'est pas un
             réglage à retirer en faisant le ménage : c'est la moitié du
             montage décrit en tête de fichier, sans laquelle la liste ne rend
             qu'un item. En contrepartie, toutes les lignes sont mesurées et
             conservées, il n'y a plus de recyclage, et rien ne plafonne la
             liste. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/archiveReportsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false"
            android:visibility="gone" />

        <!-- Section « non vérifiable » : les objets legacy stockés sans
             signature, gardés à part, jamais mêlés au témoignage vérifié. On
             peut les regarder et les exporter d'ici, sous leur propre
             étiquette. Sa liste suit la même règle que celle des rapports
             (`nestedScrollingEnabled="false"`, cf. l'en-tête). -->
        <LinearLayout
            android:id="@+id/archiveUnverifiableSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@color/wa_darker_gray"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/archive_unverifiable_title"
                android:textColor="@color/wa_orange"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/archive_unverifiable_explain"
                android:textColor="@color/wa_gray"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/archiveUnverifiableList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/archiveCloseBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:padding="12dp"
            android:text="@string/archive_close"
            android:textColor="@color/wa_gray"
            android:textSize="13sp"
            android:fontFamily="monospace" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
