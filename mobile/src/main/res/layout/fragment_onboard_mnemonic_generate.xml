<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wa_purple"
    android:padding="21dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/onboard_mnemonic_generate_title"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/wa_white"
        android:fontFamily="@font/open_sans"
        android:gravity="center"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/onboard_mnemonic_generate_explanation"
        android:textSize="14sp"
        android:textColor="@color/wa_white_80"
        android:fontFamily="@font/open_sans"
        android:gravity="center"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Les douze mots de la phrase de secours s'affichent ici.
         `accessibilityDataSensitive="yes"` (API 34+, ignoré avant) les cache aux
         services d'accessibilité qui ne se déclarent pas outils
         d'accessibilité ; les mots, ajoutés par le code, en héritent (valeur par
         défaut `auto`). Pas d'autofill non plus : rien ici n'est à remplir. -->
    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/wordsGrid"
        android:accessibilityDataSensitive="yes"
        android:importantForAutofill="noExcludeDescendants"
        tools:targetApi="34"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:columnCount="3"
        app:rowCount="4"
        app:useDefaultMargins="true"
        app:layout_constraintTop_toBottomOf="@id/subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/regenerateBtn"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="@string/onboard_mnemonic_regenerate"
        android:textColor="@color/wa_white"
        android:textSize="14sp"
        android:fontFamily="@font/open_sans"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/wordsGrid"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/nextBtn"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/round_orange_button_selector"
        app:backgroundTint="@color/wa_orange"
        android:text="@string/onboard_mnemonic_noted"
        android:textColor="@color/btn_dark_letter"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:fontFamily="@font/open_sans"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/backBtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/backBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/action_back"
        android:textColor="@color/wa_white"
        android:textSize="14sp"
        android:fontFamily="@font/open_sans"
        android:gravity="center"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
