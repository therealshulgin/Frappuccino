<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wa_purple"
    android:padding="21dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/onboard_mnemonic_confirm_title"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/wa_white"
        android:fontFamily="@font/open_sans"
        android:gravity="center"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/onboard_mnemonic_confirm_explanation"
        android:textSize="14sp"
        android:textColor="@color/wa_white_80"
        android:fontFamily="@font/open_sans"
        android:gravity="center"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/wordLabel1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="@color/wa_white"
        android:fontFamily="@font/open_sans"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/wordInput1"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@drawable/round_button_selector"
        android:textColor="@color/wa_white"
        android:textColorHint="@color/wa_white_80"
        android:hint="@string/onboard_mnemonic_confirm_hint"
        android:inputType="text"
        android:padding="12dp"
        android:fontFamily="@font/open_sans"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/wordLabel1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/wordLabel2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="@color/wa_white"
        android:fontFamily="@font/open_sans"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/wordInput1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/wordInput2"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@drawable/round_button_selector"
        android:textColor="@color/wa_white"
        android:textColorHint="@color/wa_white_80"
        android:hint="@string/onboard_mnemonic_confirm_hint"
        android:inputType="text"
        android:padding="12dp"
        android:fontFamily="@font/open_sans"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/wordLabel2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/wordLabel3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="@color/wa_white"
        android:fontFamily="@font/open_sans"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/wordInput2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/wordInput3"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@drawable/round_button_selector"
        android:textColor="@color/wa_white"
        android:textColorHint="@color/wa_white_80"
        android:hint="@string/onboard_mnemonic_confirm_hint"
        android:inputType="text"
        android:padding="12dp"
        android:fontFamily="@font/open_sans"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/wordLabel3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/errorText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/wa_orange"
        android:fontFamily="@font/open_sans"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/wordInput3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/confirmBtn"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/round_orange_button_selector"
        app:backgroundTint="@color/wa_orange"
        android:text="@string/onboard_mnemonic_confirm_button"
        android:textColor="@color/btn_dark_letter"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:fontFamily="@font/open_sans"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/backBtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/backBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/action_back"
        android:textColor="@color/wa_white"
        android:textSize="14sp"
        android:fontFamily="@font/open_sans"
        android:gravity="center"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
