<?xml version="1.0" encoding="utf-8"?>
<!--
  Frappuccino V2 — network security config.

  Never put an `expiration` attribute back on the <pin-set>. An expired NSC
  pin-set makes Android SILENTLY STOP enforcing the pins and fall back to
  system trust — a self-disabling MITM window, the opposite of fail-closed.
  The rotation runbook is stale on exactly this point: it still describes
  `expiration="2036-05-10"` as present and tells the operator to bump it at
  every rotation (docs/TLS_PINNING_ROTATION_RUNBOOK.md). There is no
  client-side expiry timer by design — the Rust verifier
  (crypto-rs/stream/src/pin.rs) is the primary pin enforcement and never
  expires by date, and cert expiry is watched relay-side by the render guard
  (render-relay-conf.sh, `openssl checkend`). The NSC pin-set is
  belt-and-suspenders, so it is kept permanent.

  What this file enforces (CRIT-01 remediation, audit Red/Blue Team V2
  2026-04-17):

    * The pinned config is keyed by host name, not by address: only
      relay.shake-document-protect.org gets TLS-only + pin-set + embedded
      anchors (see the domain-config below). A connection made to the relay's
      raw IP falls through to base-config — system trust store, no pin.
    * Three SPKI pins are accepted, matching the three embedded anchors
      (@raw/frappuccino_ca, _next, _next2). frappuccino_ca.crt has an IP-only
      SAN, so it cannot pass host-name verification for the pinned domain; per
      crypto-rs/stream/src/pin.rs:66 the relay serves the break-glass cert
      (PIN_NEXT_B64 / @raw/frappuccino_ca_next, dual SAN domain+IP).
    * No cleartext traffic except to 10.0.2.2 / 127.0.0.1 / localhost. That
      exception is meant for emulator dev, but there is a single NSC file and
      the manifest references it unconditionally, so release builds carry it
      too. (10.0.2.2 is the emulator's alias for the host; on a physical phone
      it is an ordinary private-network address, not loopback.)

  frappuccino_ca.crt is a self-signed test-relay cert, rotated 2026-05-14
  alongside the Vultr Ubuntu 24.04 reinstall, validity 2026-05-14 →
  2036-05-11. That rotation happened because the PREVIOUS private key had no
  backup, so the reinstall could only produce a fresh cert with a new SPKI
  (crypto-rs/stream/src/pin.rs). It is not the standing rule: the current key
  is backed up on the relay, and the discipline is to renew under the SAME
  keypair (certbot key reuse, docs/TLS_PINNING_ROTATION_RUNBOOK.md) — the pin
  is on the key, not on the validity dates, so such a renewal moves no pin.
  Only an actual key change forces an APK rebuild, since the pins ship inside
  the app, here and in pin.rs.
-->
<network-security-config>

    <!-- Frappuccino V2 API — the pinned relay domain.
         Trust anchors are our embedded self-signed certs only; the system CA
         store is deliberately not an anchor here (audit 2026-06-26, R-CR-2),
         and must never be added back. Under NSC the pin is checked AFTER
         chain-to-anchor, so `<certificates src="system"/>` would widen the set
         of chains that even reach the pin check — for no gain, since every
         cert we serve chains to one of the three anchors below, which is also
         why removing it cannot break a currently working connection. Pinning
         does still constrain the cert, so a system anchor is not by itself a
         MITM path: R-CR-2 rates it not directly exploitable as long as the pin
         holds, and names the post-expiry pin-set as the window it feared. The
         header above forbids the `expiration` attribute that opened that
         window.
         (Which anchor: frappuccino_ca.crt has an IP-only SAN and so cannot be
         the cert served for this host name; per crypto-rs/stream/src/pin.rs:66
         the relay serves the break-glass cert, anchored by
         @raw/frappuccino_ca_next below.)
         A future LE/domain flip (ROADMAP 1.2/1.3) serves a publicly-trusted
         cert and will need this trust-anchor block reworked (pin the LE SPKI;
         re-add a public anchor) — revisit together with the break-glass
         pin. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">relay.shake-document-protect.org</domain>
        <trust-anchors>
            <certificates src="@raw/frappuccino_ca"/>
            <!-- Break-glass / future-LE anchor. Do not drop this
                 <certificates> entry and keep only its <pin> below: the next
                 cert is self-signed under a SEPARATE key, and NSC checks the
                 pin only after chain validation reaches an anchor, so a 2nd
                 <pin> on its own would fail. It is our cert, not a CA fallback,
                 so it does not widen MITM.
                 On the LE/domain flip this anchor block is reworked: an LE cert
                 chains to public roots, not to this embedded self-signed
                 anchor, so a public anchor has to be re-added. No pin change is
                 planned there — the LE cert is meant to reuse this same keypair
                 via certbot key-reuse — and on the Rust path the flip is
                 host-only. Pre-seeded 2026-06-27 (audit 2026-06-26 D-2). -->
            <certificates src="@raw/frappuccino_ca_next"/>
            <!-- Off-host break-glass anchor: DORMANT by design — embedded, not
                 served. Do not remove it as dead config. It is the recovery
                 path for a seized relay: both served keys live on the relay and
                 are lost together in a seizure, so the fleet must already
                 trust+pin a key the relay never held. This third self-signed
                 cert's private half is generated and kept off-host, never
                 placed on the relay.
                 Its SAN is the domain only, on purpose: the replacement relay's
                 IP is unknown and it is reached by the same name, so do not
                 "fix" this cert by adding an IP. Like the next anchor, a
                 self-signed cert needs its own anchor entry (pin is checked
                 after chain-to-anchor). It is our cert, not a CA fallback.
                 Pre-seeded 2026-06-28 (audit 2026-06-26 D-2). -->
            <certificates src="@raw/frappuccino_ca_next2"/>
        </trust-anchors>
        <pin-set>
            <pin digest="SHA-256">QnGK0KvRC1vt2C4rrxwHIj0/pUbogVtTCesBK3sZXKY=</pin>
            <!-- Break-glass pin, pre-seeded 2026-06-27 (matches @raw/frappuccino_ca_next). -->
            <pin digest="SHA-256">AmIDSglLpedq4J2LANgQ6s5+uKFEuuaNSGLjHOZkhok=</pin>
            <!-- Off-host break-glass pin, pre-seeded 2026-06-28 (matches @raw/frappuccino_ca_next2). -->
            <pin digest="SHA-256">MUb4HHlUfj3c6cCQYuQMeeiWkcHga46OCZqVLuY9eCk=</pin>
        </pin-set>
    </domain-config>

    <!-- Emulator loopback (ADB reverse / 10.0.2.2) — cleartext OK for dev only -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>

    <!-- Default: no cleartext anywhere else, system CAs only -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>

</network-security-config>
