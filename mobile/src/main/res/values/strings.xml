  <!-- Stream settings : dialogs -->
  <string name="stream_settings_lock_dialog_title">Lock?</string>
  <string name="stream_settings_lock_dialog_message">The ratchet will be wiped from RAM. You will need to re-enter your PIN to stream.</string>
  <string name="stream_settings_lock_dialog_action">Lock</string>
  <string name="stream_settings_wipe_dialog_title">WIPE ALL?</string>
  <string name="stream_settings_wipe_dialog_message">This erases from this phone:\n- the V2 identity and the ratchet (public keys, current batch, ephemeral keys)\n- the report state, from which this phone signs its next recordings\n- the upload queue, including recordings not uploaded yet and those that failed\n- the videos recovered for viewing inside the app\n- the recordings that earlier versions of this app exported to Download/Frappuccino\n\nNot erased: files you exported through the system file picker. They are outside the app\'s reach.\n\nErasing overwrites then deletes; on flash memory this is best effort, an old copy of a block can survive.\n\nOnly your BIP-39 phrase will recover the streams already uploaded (via Archive Mode). Recordings not uploaded yet are lost.\n\nFor a full app reset (including the Tella PIN), uninstall and reinstall.\n\nThis action is IRREVERSIBLE.</string>
  <string name="stream_settings_wipe_dialog_action">WIPE</string>
  <string name="stream_settings_wipe_confirm_title">Final confirmation</string>
  <string name="stream_settings_wipe_confirm_message">Really wipe the V2 identity?</string>
  <string name="stream_settings_wipe_confirm_yes">YES, WIPE</string>

