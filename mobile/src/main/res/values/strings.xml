  <!-- Stream settings : dialogs -->
  <string name="stream_settings_lock_dialog_title">Lock?</string>
  <string name="stream_settings_lock_dialog_message">The ratchet will be wiped from RAM. You will need to re-enter your PIN to stream.</string>
  <string name="stream_settings_lock_dialog_action">Lock</string>
  <string name="stream_settings_wipe_dialog_title">WIPE ALL?</string>
  <string name="stream_settings_wipe_dialog_message">This wipes the V2 IDENTITY and the RATCHET:\n- Public identity (ed25519_pk + x25519_pk)\n- Current ratchet (batch + ephemeral keys)\n- Local blobs (chunks pending upload)\n\nOnly your BIP-39 phrase will recover already-uploaded streams (via Archive Mode).\n\nFor a full app reset (including the Tella PIN), uninstall and reinstall.\n\nThis action is IRREVERSIBLE.</string>
  <string name="stream_settings_wipe_dialog_action">WIPE</string>
  <string name="stream_settings_wipe_confirm_title">Final confirmation</string>
  <string name="stream_settings_wipe_confirm_message">Really wipe the V2 identity?</string>
  <string name="stream_settings_wipe_confirm_yes">YES, WIPE</string>

