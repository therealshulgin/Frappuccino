  <string name="onboard.title_camera">Capture &amp; Stream</string>
  <string name="onboard.expl_camera">Take photos, videos and stream live audio/video. All files are end-to-end encrypted before leaving your device. The server never sees your content.</string>
  <string name="onboard.title_recorder">Shake to Stream</string>
  <string name="onboard.expl_recorder">Shake your phone to instantly start an encrypted live stream. Audio and video are captured, encrypted with your sovereign key, and uploaded in real-time to a blind relay server.</string>
  <string name="onboard.title_files">Zero-Knowledge Server</string>
  <string name="onboard.expl_files">Your content is encrypted before leaving your device. The server stores only opaque blobs it cannot read. Even if seized, your data remains inaccessible without your 12-word phrase.</string>
  <string name="onboard.title_lock_finish">Lock</string>
  <string name="onboard.expl_lock_finish">Your lock is set up! You can change it anytime in Settings.</string>
