<?xml version="1.0" encoding="utf-8"?>
<!--
    REC button — active/recording state. Same ring + disc layout as
    @drawable/rec_button_idle, but the inner disc is fully saturated.
    Tap to stop; state flips back to @drawable/rec_button_idle.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- White outer ring (identical to idle for seamless state transition). -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="3dp"
                android:color="#FFFFFFFF" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <!-- Inner red disc — fully bright (= recording in progress). -->
    <item
        android:left="10dp"
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp">
        <shape android:shape="oval">
            <solid android:color="#FFCC1A1A" />
        </shape>
    </item>
</layer-list>
