<?xml version="1.0" encoding="utf-8"?>
<!--
    REC button — idle state. Blackmagic Camera app style:
    a thin white ring around a red inner disc that's dimmed when idle.
    Tap to arm recording; state flips to @drawable/rec_button_active.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- White outer ring (3dp stroke, transparent fill). -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="3dp"
                android:color="#FFFFFFFF" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <!-- Inner red disc, inset from the ring. 10dp on each side leaves a
         clean visual gap between stroke and fill. Dim red = awaiting tap. -->
    <item
        android:left="10dp"
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp">
        <shape android:shape="oval">
            <solid android:color="#66CC1A1A" />
        </shape>
    </item>
</layer-list>
