<?xml version="1.0" encoding="utf-8"?>
<!-- Frappuccino "fist cup" logo. Adaptive-icon foreground (API 26+).
     viewport = the 1024 SVG; recentred +35,-23 so the fist sits in the
     centre of the 108dp canvas (within the 72dp safe zone, not scaled up
     to avoid the circle mask clipping it). The groove is painted in the
     background colour (#050505) so it blends into the background layer,
     carving the thumb/fingers separation. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">
    <group
        android:translateX="35"
        android:translateY="-23">
        <!-- top bar (cup lid / top of fist) + thumb-palm block -->
        <path
            android:fillColor="#FF251F"
            android:pathData="M340,292 h344 a8,8 0 0 1 8,8 v48 a8,8 0 0 1 -8,8 h-344 a8,8 0 0 1 -8,-8 v-48 a8,8 0 0 1 8,-8 z M274,496 C274,474 292,456 314,456 L462,456 C484,456 500,473 500,494 L500,578 C500,610 520,637 548,646 L548,671 C548,681 540,689 530,689 L290,689 C267,689 248,670 248,647 L248,542 C248,524 258,507 274,496 Z" />
        <!-- inner groove (background colour, blends into the bg layer) -->
        <path
            android:fillColor="#050505"
            android:pathData="M452,544 C452,604 472,650 528,650 L528,689 L498,689 C465,680 451,641 451,586 L447,520 L452,520 Z" />
        <!-- 4 finger phalanges (side view) -->
        <path
            android:fillColor="#FF251F"
            android:pathData="M558,456 h114 a34,34 0 0 1 34,34 v2 a34,34 0 0 1 -34,34 h-114 a34,34 0 0 1 -34,-34 v-2 a34,34 0 0 1 34,-34 z M554,542 h108 a34,34 0 0 1 0,68 h-108 a34,34 0 0 1 0,-68 z M548,626 h100 a34,34 0 0 1 0,68 h-100 a34,34 0 0 1 0,-68 z M518,711 h118 a34,34 0 0 1 0,68 h-118 a34,34 0 0 1 0,-68 z" />
    </group>
</vector>
