mobile/keystore.properties
*.jks
*.keystore

# SSH keys — never commit
server/keys
server/keys.pub
**/id_rsa
**/id_ed25519
**/*_vultr
**/authorized_keys

# V2 server state
server/.ratchet_registry.json
server/.env

# server/deploy/ runtime secrets — env file + TLS material never committed
server/deploy/.env
server/deploy/**/.env
server/deploy/tls/*.crt
server/deploy/tls/*.key
server/deploy/tls/*.pem
server/deploy/tls/spki_sha256.txt

# Break-glass TLS key material — NEVER commit (Lot 3 D-2). The encrypted private
# key + its passphrase live OFF-host; only the PUBLIC next cert is embedded, as a
# fixture under crypto-rs/.../assets and mobile/.../res/raw (those keep the name
# frappuccino_ca_next.crt and are NOT matched here). The loose repo-root copies,
# any age ciphertext, and any passphrase file are ignored as belt-and-suspenders.
/next.crt
/next.key
/next.key.age
/next2.crt
/next2.key
/next2.key.age
*.age
passphrase*.txt

# Temporary / debug files (adb dumps, local registry copies, etc.)
_*.json
_*.xml

